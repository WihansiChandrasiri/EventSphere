DATABASE_URL=sqlite:///./eventsphere.db

# Replace this with a randomly generated secret.
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters

# false for localhost; true for an HTTPS deployment.
COOKIE_SECURE=false

# Optional demo account seeding.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_ATTENDEE_PASSWORD=